# Credentials used by the integration test suite (tests/Integration).
# Copy this file to .env and fill it in, or export the same variables -
# real environment variables take precedence over the values in .env.
#
# Run the suite with: vendor/bin/phpunit --testsuite integration

PINGEN2_CLIENT_ID=
PINGEN2_CLIENT_SECRET=

# Optional. When empty, the first organisation of the account is used.
PINGEN2_ORGANIZATION_ID=
# Optional. When set, the organisation details test asserts on this name.
PINGEN2_ORGANIZATION_NAME=

# Integration tests must never run against production, keep this on true.
PINGEN2_USE_STAGING=true
